# SETU environment template.
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored — never commit real credentials.

# ---------- LLM provider ----------
# "groq" (cloud, primary) or "ollama" (local fallback). Switching providers is
# a one-line change here; no code edits required.
LLM_PROVIDER=groq

# Required when LLM_PROVIDER=groq. Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Used when LLM_PROVIDER=ollama. Requires a local Ollama daemon.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ---------- Hugging Face ----------
# Optional for public models like BGE-M3, but avoids anonymous rate limits and
# is required if you ever pull a gated IndicTrans2 / IndicLID artefact.
HUGGINGFACE_TOKEN=

# ---------- Qdrant ----------
QDRANT_URL=http://localhost:6333
# Leave blank for the local docker-compose instance (no auth by default).
QDRANT_API_KEY=
QDRANT_COLLECTION=setu_schemes

# ---------- Langfuse ----------
# Create a project in the local Langfuse UI (http://localhost:3000) to get these.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ---------- API server ----------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
