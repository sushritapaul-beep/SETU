# SETU environment template.
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored — never commit real credentials.
#
# Every backing service below is free-tier cloud — nothing here needs local
# infrastructure.

# ---------- LLM provider ----------
# "groq" (cloud, primary) or "ollama" (local fallback). Switching providers is
# a one-line change here; no code edits required.
LLM_PROVIDER=groq

# Required when LLM_PROVIDER=groq. Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Used when LLM_PROVIDER=ollama. Requires a local Ollama daemon.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ---------- Jina AI (embeddings + reranking) ----------
# Free trial key at https://jina.ai/embeddings or https://jina.ai/reranker —
# either page issues the same key, shared across both APIs.
JINA_API_KEY=

# ---------- Azure AI Translator ----------
# Free F0 tier (2M characters/month) via a Translator resource in the Azure
# portal. AZURE_TRANSLATOR_REGION is only needed for a regional resource —
# leave blank if the resource was provisioned as "Global".
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# ---------- Qdrant Cloud ----------
# Free cluster at https://cloud.qdrant.io — copy the cluster URL and API key
# from its dashboard.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=setu-schemes

# ---------- Langfuse Cloud ----------
# Free Hobby plan at https://cloud.langfuse.com — create a project, then copy
# its keys. LANGFUSE_HOST differs by signup region (EU vs US).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- API server ----------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Origins allowed to call the API cross-origin. Defaults cover local dev
# (API on :8000, Chainlit UI on :8001); add the UI's real deployed origin in
# production, e.g. https://setu-ui.onrender.com
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001
# Required before exposing the API publicly on any deploy target — each
# request spends metered LLM/API quota. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The UI sends this back as X-API-Key (docker-compose.yml reuses this same
# value for both API_KEY and the UI's SETU_API_KEY — set it once here).
# Left unset for local development.
API_KEY=

# ---------- docker-compose.yml (deploy/oracle/) only ----------
# Tunnel token from Cloudflare Zero Trust -> Networks -> Tunnels -> Create a
# tunnel. Not used by any other deploy target. See deploy/oracle/README.md.
CLOUDFLARE_TUNNEL_TOKEN=
